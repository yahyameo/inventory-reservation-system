# HTTP port
PORT=3000
# Storage adapter: "memory" (default) or "mongo"
STORAGE_DRIVER=memory
# Required when STORAGE_DRIVER=mongo. Must point at a replica set (transactions are used).
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB_NAME=inventory
# How long a reservation holds stock (ms). Spec: 2 minutes.
RESERVATION_HOLD_MS=120000
# How often the background sweeper releases expired reservations (ms).
EXPIRY_SWEEP_INTERVAL_MS=5000
